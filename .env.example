# engops.avilaops.com
#
# Produção: /opt/engops/.env no Hetzner apps-noclient (chmod 600). Nunca commitar valores.

DATABASE_URL=postgresql://engops:senha@host.docker.internal:5432/engops

# Login único da casa (auth.avilaops.com). O cookie `avila_sso` chega sozinho em
# *.avilaops.com; este segredo confere a assinatura localmente. Mesmo valor do auth.
SSO_JWT_SECRET=
SSO_BASE_URL=https://auth.avilaops.com
ENGOPS_SITE_URL=https://engops.avilaops.com

# Desenvolvimento sem SSO: e-mail que a sessão assume quando não há cookie.
# Ignorado em produção.
ENGOPS_DEV_EMAIL=

# Quem administra tudo (pode criar empresas e entrar em qualquer uma). Lista separada por vírgula.
ENGOPS_DONOS=nicolas@avilaops.com

# Documentos: Cloudflare R2. Sem as quatro variáveis, grava em ./storage (só desenvolvimento).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Motor de automação: 1 liga o processador de jobs neste processo.
ENGOPS_WORKER=1

# Token para serviço (n8n) falar com este app.
ENGOPS_SERVICE_TOKEN=
# n8n: webhook que recebe os eventos de domínio (DemandaCriada, DocumentoSolicitado...).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
