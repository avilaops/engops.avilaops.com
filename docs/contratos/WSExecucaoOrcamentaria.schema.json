          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "senha": {
          "type": "string",
          "writeOnly": true,
          "description": "Hash MD5, tratado como segredo de autenticação.",
          "pattern": "^[a-fA-F0-9]{32}$"
        },
        "usuario": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "senha",
        "usuario"
      ],
      "additionalProperties": false
